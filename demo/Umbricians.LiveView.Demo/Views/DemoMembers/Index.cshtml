@using Umbricians.LiveView.Messaging.Members
@model Umbricians.LiveView.Demo.DemoMembers.DemoMembersViewModel
@{
    Layout = null;

    string TypeClass(MemberMessageType type) => type switch
    {
        MemberMessageType.Warning => "warning",
        MemberMessageType.Urgent => "urgent",
        MemberMessageType.GoodNews => "good",
        _ => "info",
    };
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Demo member login</title>
    <style>
        body { font-family: system-ui, sans-serif; max-width: 560px; margin: 48px auto; padding: 0 16px; color: #1b264f; }
        .card { border: 1px solid #e9e9eb; border-radius: 8px; padding: 20px; margin-bottom: 16px; }
        .status { font-size: 1.1rem; }
        .error { color: #d42054; }
        select, button { font: inherit; padding: 6px 10px; }
        button { background: #3544b1; color: #fff; border: 0; border-radius: 4px; cursor: pointer; }
        .muted { color: #68676b; font-size: 0.9rem; }

        /* Banners: messages queued by the "Banner on next page" sender. */
        .banner { display: flex; gap: 12px; align-items: flex-start; border-radius: 8px; padding: 12px 16px; margin-bottom: 12px; }
        .banner .text { flex: 1; }
        .banner strong { display: block; }
        .banner p { margin: 4px 0 0; white-space: pre-line; }
        .banner button { background: transparent; color: inherit; border: 1px solid currentColor; padding: 2px 8px; }
        .info { background: #e8ebff; } .warning { background: #fff4d6; } .urgent { background: #ffe1e6; } .good { background: #dcf5e8; }

        /* Live pop-ups: messages pushed by the "Live pop-up (SignalR)" sender. */
        #toasts { position: fixed; top: 16px; right: 16px; display: grid; gap: 8px; width: min(360px, calc(100% - 32px)); }
        .toast { border-radius: 8px; padding: 12px 16px; box-shadow: 0 4px 16px rgba(0, 0, 0, .15); }
        .toast p { margin: 4px 0 0; white-space: pre-line; }
    </style>
</head>
<body>
    @foreach (var banner in Model.Banners)
    {
        <div class="banner @TypeClass(banner.Type)" role="status">
            <div class="text">
                <strong>@banner.Headline</strong>
                @if (!string.IsNullOrEmpty(banner.Body))
                {
                    <p>@banner.Body</p>
                }
                @if (banner.SenderName is not null)
                {
                    <p class="muted">– @banner.SenderName</p>
                }
            </div>
            <form method="post" action="/demo/members/dismiss/@banner.Key">
                @Html.AntiForgeryToken()
                <button type="submit" aria-label="Dismiss">Dismiss</button>
            </form>
        </div>
    }

    <h1>Demo member login</h1>
    <p class="muted">Test page for the Live View members line and member messages. Not part of the package.</p>

    @if (Model.Error is not null)
    {
        <p class="error">@Model.Error</p>
    }

    <div class="card">
        @if (Model.CurrentEmail is not null)
        {
            <p class="status">Logged in as <strong>@Model.CurrentName</strong> (@Model.CurrentEmail)</p>
            <form method="post" action="/demo/members/logout">
                @Html.AntiForgeryToken()
                <button type="submit">Log out</button>
            </form>
        }
        else
        {
            <p class="status">Not logged in.</p>
            <form method="post" action="/demo/members/login">
                @Html.AntiForgeryToken()
                <label for="email">Log in as</label>
                <select id="email" name="email">
                    @foreach (var account in Model.Accounts)
                    {
                        <option value="@account.Email">@account.Name (@account.Email)</option>
                    }
                </select>
                <button type="submit">Log in</button>
            </form>
        }
    </div>

    <p class="muted">
        Each browser (or private window) holds one member session. To have several members online at once, log in
        from different browsers or private windows.
    </p>

    <div id="toasts" aria-live="polite"></div>

    @if (Model.CurrentEmail is not null)
    {
        <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@8.0.7/dist/browser/signalr.min.js"></script>
        <script>
            // Live pop-ups from the Live View dashboard. Text is set with textContent, never as HTML.
            const classes = { Information: "info", Warning: "warning", Urgent: "urgent", GoodNews: "good" };
            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/demo/hubs/member-messages")
                .withAutomaticReconnect()
                .build();

            connection.on("message", (message) => {
                const toast = document.createElement("div");
                toast.className = `toast ${classes[message.type] ?? "info"}`;
                const headline = document.createElement("strong");
                headline.textContent = message.headline;
                toast.append(headline);
                if (message.body) {
                    const body = document.createElement("p");
                    body.textContent = message.body;
                    toast.append(body);
                }
                if (message.senderName) {
                    const from = document.createElement("p");
                    from.className = "muted";
                    from.textContent = `– ${message.senderName}`;
                    toast.append(from);
                }
                document.getElementById("toasts").append(toast);
                setTimeout(() => toast.remove(), 15000);
            });

            connection.start().catch((error) => console.warn("Live messages unavailable", error));
        </script>
    }
</body>
</html>
