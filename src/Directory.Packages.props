<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- The Umbraco versions the package supports: from the lowest version of the major being built (UmbracoVersion
         in Directory.Build.props) up to, but not including, the next major or any of its pre-releases. N.0.0-a sorts
         below every N.0.0 pre-release nuget.org can hold (it compares labels ignoring case, and refuses labels that
         don't start with a letter, such as N.0.0-0). Sites on newer versions of the same major resolve their own, and
         NuGet won't install the package on another major or its pre-releases. -->
    <UmbracoVersionRange>[$(UmbracoVersion), $([MSBuild]::Add($(UmbracoMajor), 1)).0.0-a)</UmbracoVersionRange>
  </PropertyGroup>

  <ItemGroup>
    <!-- .github/dependabot.yml ignores each of these, so a new one goes in its list too. -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(UmbracoVersionRange)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoVersionRange)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoVersionRange)" />
  </ItemGroup>
</Project>
