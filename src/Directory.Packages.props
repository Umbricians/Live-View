<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lowest Umbraco 17 version the package supports; sites on newer versions resolve their own.
         .github/dependabot.yml ignores each of these, so a new one goes in its list too. -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="17.8.0" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="17.8.0" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="17.8.0" />
  </ItemGroup>
</Project>
