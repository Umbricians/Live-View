<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- The lowest version of the Umbraco major being built that the package supports (UmbracoVersion in
         Directory.Build.props); sites on newer versions resolve their own. .github/dependabot.yml ignores each of
         these, so a new one goes in its list too. -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="$(UmbracoVersion)" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="$(UmbracoVersion)" />
  </ItemGroup>
</Project>
