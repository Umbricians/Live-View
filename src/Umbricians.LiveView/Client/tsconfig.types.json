{
  // Declarations for src/index.ts, shipped next to the bundle so sites can type their panels.
  // Only the entry and what it reaches are emitted.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "../wwwroot/App_Plugins/UmbriciansLiveView/types",
    "rootDir": "src"
  },
  "files": [ "src/index.ts" ],
  "include": []
}
